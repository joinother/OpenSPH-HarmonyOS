 NAMESPACE_SPH_BEGIN
 
+// ---------- OpenSPH-on-HarmonyOS diagnostic tracing ----------
+// Traces go to hilog (tag "OpenSPH") so they can be read with:
+//   hilog -x | grep "OpenSPH"
+#define OSPH_TRACE(...)                                                                  \
+    do {                                                                                 \
+        char _buf[512];                                                                  \
+        snprintf(_buf, sizeof(_buf), __VA_ARGS__);                                       \
+        OH_LOG_Print(LOG_APP, LOG_INFO, 0x0100, "OpenSPH", "%{public}s", _buf);          \
+    } while (0)
+
+class OpenSphTraceFilter : public wxEventFilter {
+public:
+    OpenSphTraceFilter() = default;
+
+    int FilterEvent(wxEvent& evt) override {
+        const wxEventType t = evt.GetEventType();
+        if (t == wxEVT_LEFT_DOWN || t == wxEVT_RIGHT_DOWN) {
+            const wxMouseEvent& me = static_cast<const wxMouseEvent&>(evt);
+            wxWindow* win = dynamic_cast<wxWindow*>(me.GetEventObject());
+            OSPH_TRACE("mouse %s at (%d,%d) on '%s'",
+                t == wxEVT_LEFT_DOWN ? "LEFT_DOWN" : "RIGHT_DOWN", me.GetX(), me.GetY(),
+                win ? win->GetName().c_str().AsChar() : "?");
+        } else if (t == wxEVT_MENU) {
+            const wxCommandEvent& ce = static_cast<const wxCommandEvent&>(evt);
+            OSPH_TRACE("menu selected id=%d", ce.GetId());
+        } else if (t == wxEVT_CLOSE_WINDOW) {
+            OSPH_TRACE("close window requested");
+        }
+        return wxEventFilter::Event_Skip;
+    }
+};
