+// ---------- OpenSPH-on-HarmonyOS diagnostic tracing ----------
+// Traces go to hilog (tag "OpenSPH") so they can be read with:
+//   hilog -x | grep "OpenSPH"
+#define OSPH_TRACE(...)                                                                  \
+    do {                                                                                 \
+        char _buf[512];                                                                  \
+        snprintf(_buf, sizeof(_buf), __VA_ARGS__);                                       \
+        OH_LOG_Print(LOG_APP, LOG_INFO, 0x0100, "OpenSPH", "%{public}s", _buf);          \
