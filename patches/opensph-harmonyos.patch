diff --git a/gui/launcherGui/LauncherGui.cpp b/gui/launcherGui/LauncherGui.cpp
index 5455a17..7c58da8 100644
--- a/gui/launcherGui/LauncherGui.cpp
+++ b/gui/launcherGui/LauncherGui.cpp
@@ -1,16 +1,207 @@
 #include "gui/launcherGui/LauncherGui.h"
+#include "gui/launcherGui/OhosCli.h"
 #include "gui/windows/MainWindow.h"
 #include <wx/msgdlg.h>
+#include <wx/log.h>
+#include <wx/intl.h>
+#include <wx/translation.h>
+#include <clocale>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <cstdio>
+#include <vector>
+#include <hilog/log.h>
 
 IMPLEMENT_APP(Sph::App);
 
 NAMESPACE_SPH_BEGIN
 
+#define OSPH_TRACE(...)                                                                  \
+    do {                                                                                 \
+        char _buf[512];                                                                  \
+        snprintf(_buf, sizeof(_buf), __VA_ARGS__);                                       \
+        OH_LOG_Print(LOG_APP, LOG_INFO, 0x0100, "OpenSPH", "%{public}s", _buf);          \
+    } while (0)
+
+// ---------------------------------------------------------------------------
+// i18n: load OpenSPH.mo (gettext-style) catalog. Language is selected from the
+// OSPH_LANG env var (e.g. "zh_CN", "en"); default is Simplified Chinese. The
+// catalog directory is taken from OSPH_LANG_DIR if set, otherwise the
+// HarmonyOS sandbox files dir is used. On the HarmonyOS port the catalog is
+// copied asynchronously from the HAP rawfile by the ArkTS shell, so we poll
+// briefly for its arrival. Falls back to English and never crashes when the
+// catalog is missing.
+// ---------------------------------------------------------------------------
+static wxLocale* g_locale = nullptr;
+
+static void SetupI18n() {
+    g_locale = new wxLocale;
+
+    wxLanguage lang = wxLANGUAGE_CHINESE_SIMPLIFIED;
+    if (const char* lg = getenv("OSPH_LANG")) {
+        wxString langName(lg, wxConvUTF8);
+        const wxLanguageInfo* info = wxLocale::FindLanguageInfo(langName);
+        if (info) {
+            lang = (wxLanguage)info->Language;
+        }
+    }
+    const bool initOk = g_locale->Init(lang);
+    if (!initOk) {
+        g_locale->Init(wxLANGUAGE_ENGLISH);
+    }
+    OSPH_TRACE("i18n: Init(lang=%d)=%d canonical='%s'",
+        (int)lang, initOk ? 1 : 0,
+        g_locale->GetCanonicalName().utf8_string().c_str());
+
+    // Catalog directory: OSPH_LANG_DIR env var, else HarmonyOS sandbox files dir.
+    wxString moDir;
+    if (const char* d = getenv("OSPH_LANG_DIR")) {
+        moDir = wxString(d, wxConvUTF8);
+    } else {
+        moDir = "/data/storage/el2/base/haps/entry/files";
+    }
+
+    // The ArkTS shell copies OpenSPH.mo from rawfile asynchronously; poll up
+    // to ~3 s for it to arrive before trying to load the catalog.
+    const wxString moPath = moDir + "/OpenSPH.mo";
+    for (int i = 0; i < 12 && access(moPath.utf8_string().c_str(), R_OK) != 0; ++i) {
+        usleep(250 * 1000);
+    }
+
+    // wxFileTranslationsLoader only searches <prefix>/<lang>/LC_MESSAGES and
+    // <prefix>/<lang>, NOT <prefix> directly. Replicate the .mo into those
+    // subdirs (POSIX mkdir works inside the app sandbox).
+    {
+        struct stat st;
+        const std::string src = moPath.utf8_string();
+        if (stat(src.c_str(), &st) == 0) {
+            const char* subs[][2] = {
+                { "zh_CN", "LC_MESSAGES" },
+                { "zh_CN", "" },
+                { "zh_Hans", "LC_MESSAGES" },
+                { "zh_Hans", "" },
+            };
+            for (const auto& s : subs) {
+                std::string dir;
+                if (s[1][0]) {
+                    std::string l1 = moDir.utf8_string() + "/" + s[0];
+                    mkdir(l1.c_str(), 0755);
+                    std::string l2 = l1 + "/" + s[1];
+                    mkdir(l2.c_str(), 0755);
+                    dir = l2;
+                } else {
+                    dir = moDir.utf8_string() + "/" + s[0];
+                    mkdir(dir.c_str(), 0755);
+                }
+                std::string dst = dir + "/OpenSPH.mo";
+                FILE* in = fopen(src.c_str(), "rb");
+                FILE* out = fopen(dst.c_str(), "wb");
+                if (in && out) {
+                    char buf[8192];
+                    size_t n;
+                    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
+                        fwrite(buf, 1, n, out);
+                    }
+                }
+                if (in) {
+                    fclose(in);
+                }
+                if (out) {
+                    fclose(out);
+                }
+            }
+        }
+    }
+
+    wxFileTranslationsLoader::AddCatalogLookupPathPrefix(moDir);
+    // OpenSPH.mo / zh_CN/LC_MESSAGES/OpenSPH.mo ...
+    const bool catalogOk = g_locale->AddCatalog("OpenSPH");
+
+    // TEMP i18n diagnostics -> hilog
+    OSPH_TRACE("i18n: moDir=%s moPathExists=%d AddCatalog=%d lang=%d",
+        moDir.utf8_string().c_str(),
+        access(moPath.utf8_string().c_str(), R_OK) == 0 ? 1 : 0,
+        catalogOk ? 1 : 0,
+        (int)lang);
+    OSPH_TRACE("i18n: probe '&Project' -> '%s'",
+        wxGetTranslation("&Project").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'Material' -> '%s'",
+        wxGetTranslation("Material").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'New session' -> '%s'",
+        wxGetTranslation("New session").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'Batch run' -> '%s'",
+        wxGetTranslation("Batch run").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'Visualization settings' -> '%s'",
+        wxGetTranslation("Visualization settings").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'Render setup' -> '%s'",
+        wxGetTranslation("Render setup").utf8_string().c_str());
+    OSPH_TRACE("i18n: probe 'Cancel' -> '%s'",
+        wxGetTranslation("Cancel").utf8_string().c_str());
+
+    // Never let the locale change numeric/date formatting: the simulation core
+    // relies on C-style "%g"/"%f" output (e.g. "2700", "2.67e+10").
+    std::setlocale(LC_NUMERIC, "C");
+    std::setlocale(LC_TIME, "C");
+}
+
 bool App::OnInit() {
 #ifndef SPH_DEBUG
     wxDisableAsserts();
 #endif
 
+    // TEMP-TEST: enable auto material node
+    setenv("OSPH_AUTOTEST", "1", 1);
+    setenv("OSPH_TESTSCROLL", "1", 1);
+    setenv("OSPH_PG_DIRECT", "1", 1);
+
+    // On the HarmonyOS port there is no console; route wxLog output to stderr
+    // so that OSPH_TRACE diagnostics appear in hilog.
+    wxLog::SetActiveTarget(new wxLogStderr());
+
+    // i18n: initialize translations before any window/string is created.
+    SetupI18n();
+
+    // -----------------------------------------------------------------------
+    // Headless CLI mode: if a CLI command is provided (via the OSPH_CLI_ARGS
+    // env var or the sandbox arg file written by the ArkTS shell), run the
+    // requested OpenSPH job tree without opening any window and exit with the
+    // CLI exit code. Output goes to hilog (see OhosCli.cpp).
+    // -----------------------------------------------------------------------
+    {
+        const char* cliFile = "/data/storage/el2/base/haps/entry/files/opensph_cli.txt";
+        String cliArgs;
+        if (const char* env = getenv("OSPH_CLI_ARGS")) {
+            cliArgs = String::fromUtf8(env);
+        } else {
+            for (int i = 0; i < 40; ++i) { // wait for the ArkTS shell to write the arg file (~2s max)
+                if (access(cliFile, R_OK) == 0) {
+                    FILE* f = fopen(cliFile, "rb");
+                    if (f) {
+                        fseek(f, 0, SEEK_END);
+                        const long len = ftell(f);
+                        fseek(f, 0, SEEK_SET);
+                        std::vector<char> buf(len + 1, 0);
+                        if (len > 0 && fread(buf.data(), 1, len, f) > 0) {
+                            cliArgs = String::fromUtf8(buf.data());
+                        }
+                        fclose(f);
+                        break;
+                    }
+                }
+                usleep(50 * 1000);
+            }
+        }
+        if (!cliArgs.empty()) {
+            // one-shot semantics: consume and delete the arg file so a later
+            // GUI start (without CLI args) does not re-trigger headless mode.
+            unlink(cliFile);
+            OSPH_TRACE("cli: executing headless command: %s", cliArgs.toUtf8().cstr());
+            const int exitCode = runCliCommand(cliArgs);
+            OSPH_TRACE("cli: finished with exit code %d", exitCode);
+            std::exit(exitCode);
+        }
+    }
+
     this->Connect(MAIN_LOOP_TYPE, MainLoopEventHandler(App::processEvents));
 
     if (wxTheApp->argc > 1) {
@@ -21,6 +212,16 @@ bool App::OnInit() {
     }
     window->SetAutoLayout(true);
     window->Show();
+
+    // TEMP-TEST: the frame requests Maximize() in its ctor before the Qt
+    // window exists; re-apply it after the first show so the HarmonyOS
+    // window manager actually maximizes it (gives the property panel its
+    // full height so the material parameters are not clipped).
+    MainWindow* win = window;
+    window->CallAfter([win] {
+        win->Maximize(true);
+    });
+
     return true;
 }
 
