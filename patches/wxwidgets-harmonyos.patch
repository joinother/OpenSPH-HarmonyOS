+                     (void*)this, x, y);
+            wxQtHilog(buf);
+        }
+    }
+
+    // Forward the wx virtual size to the underlying QScrollArea so that
+    // scrollbars appear for wxScrolled-based controls (e.g. wxPropertyGrid).
+    // The base wx implementation only stores m_virtualSize and never tells Qt
+    // about it, which left wxScrolled windows without working scrollbars on
+    // the Qt backend.
+    if ( QScrollArea *area = qobject_cast<QScrollArea*>( m_qtContainer ) )
+    {
+        const int clientW = GetClientSize().GetWidth();
+        const int clientH = GetClientSize().GetHeight();
+
+        if ( QScrollBar *vsb = area->verticalScrollBar() )
+        {
+            if ( y > clientH )
+            {
+                vsb->setRange( 0, y - clientH );
+                vsb->setPageStep( clientH );
+                vsb->show();
+                area->setVerticalScrollBarPolicy( Qt::ScrollBarAlwaysOn );
+            }
+            else
+            {
+                area->setVerticalScrollBarPolicy( Qt::ScrollBarAsNeeded );
+            }
+        }
+
+        if ( QScrollBar *hsb = area->horizontalScrollBar() )
+        {
+            if ( x > clientW )
+            {
+                hsb->setRange( 0, x - clientW );
+                hsb->setPageStep( clientW );
+                hsb->show();
+                area->setHorizontalScrollBarPolicy( Qt::ScrollBarAlwaysOn );
+            }
+            else
+            {
+                area->setHorizontalScrollBarPolicy( Qt::ScrollBarAsNeeded );
+            }
+        }
+    }
+}
