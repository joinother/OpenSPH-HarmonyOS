+void wxWindowQt::ReapplyScrollbars()
+{
+    QScrollArea *area = qobject_cast<QScrollArea*>( m_qtContainer );
+    if ( !area )
+        return;
+
+    const wxSize vs = GetVirtualSize();
+    const wxSize cs = GetClientSize();
+    if ( cs.x <= 0 || cs.y <= 0 )
+        return;
+
+    {
+        char buf[256];
+        snprintf(buf, sizeof(buf), "Reapply vs=%dx%d cs=%dx%d policy=%d/%d vis=%d/%d",
+                 vs.x, vs.y, cs.x, cs.y,
+                 (int)area->verticalScrollBarPolicy(), (int)area->horizontalScrollBarPolicy(),
+                 area->verticalScrollBar()->isVisible(), area->horizontalScrollBar()->isVisible());
+        wxQtHilog(buf);
+    }
+
+    // Vertical
+    if ( vs.y > cs.y )
+    {
+        QScrollBar *sb = area->verticalScrollBar();
+        if ( sb )
+        {
+            sb->setRange( 0, vs.y - cs.y );
+            sb->setPageStep( cs.y );
+            sb->show();
+        }
+        area->setVerticalScrollBarPolicy( Qt::ScrollBarAlwaysOn );
+    }
+    else
+    {
+        area->setVerticalScrollBarPolicy( Qt::ScrollBarAsNeeded );
+    }
+
+    // Horizontal
+    if ( vs.x > cs.x )
+    {
+        QScrollBar *sb = area->horizontalScrollBar();
+        if ( sb )
+        {
+            sb->setRange( 0, vs.x - cs.x );
+            sb->setPageStep( cs.x );
+            sb->show();
+        }
+        area->setHorizontalScrollBarPolicy( Qt::ScrollBarAlwaysOn );
+    }
+    else
+    {
+        area->setHorizontalScrollBarPolicy( Qt::ScrollBarAsNeeded );
+    }
+}
